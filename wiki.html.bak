        <h2>EV/RV - Efeito vs Resistência</h2>
        <p id="ar-mode-desc">Para efeitos temporários que não persistem após a cena.</p>
        
        <div class="table-container">
        <table class="ar-table" id="evrv-table">
          <tr><th>EV/RV</th><th>1</th><th>2</th><th>3</th><th>4</th><th>5</th><th>6</th><th>7</th><th>8</th><th>9</th><th>10</th><th>11</th><th>12</th><th>13</th><th>14</th><th>15</th><th>16</th><th>17</th><th>18</th><th>19</th><th>20</th></tr>
        </table>
        </div>
        <p style="font-size: 0.7rem; color: var(--muted); margin-top: 10px;">Nota: "N" significa que a ação falha automaticamente.</p>
        <p style="font-size: 0.7rem; color: var(--muted); margin-top: 8px;"><em>Exemplo: Se seu EV é 3 e o efeito é persistente, some +2 ao EV (3+2=5) e use 5 na tabela.</em></p>
      \`
    };
    
    var evrvData = {
      1: [1,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      2: [2,1,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      3: [4,3,1,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      4: [6,4,3,1,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      5: [8,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      6: [9,7,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      7: [11,8,7,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N','N','N'],
      8: [12,9,8,6,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N','N'],
      9: [14,11,9,8,7,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N'],
      10: [16,12,10,9,8,7,5,4,3,2,'N','N','N','N','N','N','N','N','N','N'],
      11: [17,14,12,10,9,8,7,6,4,3,2,'N','N','N','N','N','N','N','N','N'],
      12: [19,15,13,11,10,9,8,7,6,5,4,2,'N','N','N','N','N','N','N','N'],
      13: [21,16,14,13,11,10,9,8,7,6,5,4,3,'N','N','N','N','N','N','N'],
      14: [22,18,16,14,13,11,10,9,8,7,6,5,4,3,'N','N','N','N','N','N'],
      15: [24,19,17,15,14,13,11,10,9,8,7,6,5,4,3,'N','N','N','N','N']
    };
    
    window.showARMode = function(mode) {
      var offset = mode === 'persist' ? 2 : (mode === 'perm' ? 5 : 0);
      var desc = document.getElementById('ar-mode-desc');
      if (!desc) return;
      
      desc.innerHTML = mode === 'temp' 
        ? 'Para efeitos temporários que não persistem após a cena.' 
        : (mode === 'persist' 
            ? 'Para efeitos persistentes. <strong>Some +2 ao seu EV</strong> antes de consultar a tabela.' 
            : 'Para efeitos permanentes e transformações. <strong>Some +5 ao seu EV</strong> antes de consultar a tabela.');
      
      var table = document.getElementById('evrv-table');
      if (!table) return;
      
      table.innerHTML = '<tr><th>EV/RV</th><th>1</th><th>2</th><th>3</th><th>4</th><th>5</th><th>6</th><th>7</th><th>8</th><th>9</th><th>10</th><th>11</th><th>12</th><th>13</th><th>14</th><th>15</th><th>16</th><th>17</th><th>18</th><th>19</th><th>20</th></tr>';
      
      for (var i = 1; i <= 15; i++) {
        var ev = i + offset;
        var row = evrvData[ev] || evrvData[15];
        var tr = document.createElement('tr');
        tr.innerHTML = '<th>' + i + '</th>' + row.map(function(v) { return '<td>' + v + '</td>'; }).join('');
        table.appendChild(tr);
      }
      
      document.querySelectorAll('.ar-mode-btn').forEach(function(btn) {
        btn.classList.remove('active');
      });
      var activeBtn = document.querySelector('.ar-mode-btn[data-mode="' + mode + '"]');
      if (activeBtn) activeBtn.classList.add('active');
    };
    
    window.initARTable = function() {
      showARMode('temp');
    };
    
    var evrvData = {
      1: [1,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      2: [2,1,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      3: [4,3,1,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      4: [6,4,3,1,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      5: [8,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      6: [9,7,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N','N','N','N'],
      7: [11,8,7,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N','N','N'],
      8: [12,9,8,6,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N','N'],
      9: [14,11,9,8,7,5,4,3,2,'N','N','N','N','N','N','N','N','N','N','N'],
      10: [16,12,10,9,8,7,5,4,3,2,'N','N','N','N','N','N','N','N','N','N'],
      11: [17,14,12,10,9,8,7,6,4,3,2,'N','N','N','N','N','N','N','N','N'],
      12: [19,15,13,11,10,9,8,7,6,5,4,2,'N','N','N','N','N','N','N','N'],
      13: [21,16,14,13,11,10,9,8,7,6,5,4,3,'N','N','N','N','N','N','N'],
      14: [22,18,16,14,13,11,10,9,8,7,6,5,4,3,'N','N','N','N','N','N'],
      15: [24,19,17,15,14,13,11,10,9,8,7,6,5,4,3,'N','N','N','N','N']
    };
    
    function loadPage(page) {
      const content = pages[page] || pages.index;
      wikiContent.innerHTML = content;
      
      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.dataset.page === page || (page === 'index' && !link.dataset.page)) {
          link.classList.add('active');
        }
      });
    }
    
    const urlParams = new URLSearchParams(window.location.search);
    const initialPage = urlParams.get('p') || 'index';
    loadPage(initialPage);
    
    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const page = link.dataset.page;
        window.history.pushState({}, '', `wiki.html?p=${page}`);
        loadPage(page);
      });
    });
    
    initTheme();
    renderThemeDots();
    
    // Initialize music player on wiki load
    if (window.initMusicPlayer) {
      initMusicPlayer();
    }
  </script>
</body>
</html>

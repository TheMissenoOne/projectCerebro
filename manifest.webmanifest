{
  "name": "Project Cérebro — X-MEN TTRPG",
  "short_name": "Cérebro",
  "description": "Fichas, base de NPCs, wiki de regras e calculadora de combate do X-MEN TTRPG do Instituto Xavier.",
  "id": "./",
  "start_url": "./dashboard.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#080808",
  "theme_color": "#080808",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["games", "entertainment", "utilities"],
  "icons": [
    { "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/pwa-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Nova ficha",
      "short_name": "Ficha",
      "url": "./ficha.html?new=true",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Cérebro (NPCs)",
      "short_name": "Cérebro",
      "url": "./cerebro.html",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Wiki de regras",
      "short_name": "Wiki",
      "url": "./wiki.html",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Calculadora de combate",
      "short_name": "Combate",
      "url": "./combate.html",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
